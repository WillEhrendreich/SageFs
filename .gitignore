# on CI it is uploaded as the release-assets artifact, never committed.
release/

# Scratch copies the hot-reload state tests build per runtime (HotReloadStateHarness).
SageFs.Tests/fixtures/HotReloadStateFixture/.runs/
SageFs.Tests/fixtures/HotReloadParityFixture/.runs/
SageFs.Tests/fixtures/HotReloadGenericReflectionFixture/.runs/
SageFs.Tests/fixtures/RunAppDeltaFixture/.runs/
