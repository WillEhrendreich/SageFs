<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <IsPackable>false</IsPackable>
        <!-- Deterministic Simulation Testing (DST) harness for the pure
             supervision core. Targets net10.0 like SageFs.Core (see
             Directory.Build.props). Pure F#, no IO, no third-party deps —
             only SageFs.Core, so the harness folds through the REAL policy. -->
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Scenario.fs" />
        <Compile Include="Runner.fs" />
        <Compile Include="Invariants.fs" />
        <Compile Include="Generators.fs" />
        <!-- Phase 2: SessionManager worker-lifecycle pid-race simulation. -->
        <Compile Include="WorkerLifecycleSim.fs" />
        <Compile Include="WorkerLifecycleInvariants.fs" />
        <Compile Include="MgrGenerators.fs" />
        <!-- Phase 3 Brief B5: ManifestOwner / ManifestMutation concurrency + fault DST. -->
        <Compile Include="ManifestSim.fs" />
        <Compile Include="ManifestInvariants.fs" />
        <Compile Include="ManifestGenerators.fs" />
        <!-- Phase 3A / Brief B1: reference-vs-candidate oracle for the
             supervision core. -->
        <Compile Include="ReferenceModel.fs" />
        <Compile Include="Oracle.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SageFs.Core\SageFs.Core.fsproj" />
    </ItemGroup>

</Project>
