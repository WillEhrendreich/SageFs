#!/usr/bin/env bash
# scripts/local-gate [<commit>]        gate a commit (default HEAD) on this machine
# scripts/local-gate --force <commit>  re-gate even if it already passed
# scripts/local-gate --promote <commit> <dir>
#                                      copy a passed commit's release bundle into <dir>
#                                      (used by the self-hosted "main build" job)
#
# THE gate is the pipeline itself: `dotnet fsi ci-pipeline.fsx -- ci release`,
# run on a CLEAN checkout of exactly one commit. Nothing here re-derives or
# re-lists stages, so the gate can never drift from what CI means. Running it
# on a clean checkout (never the working tree) is what answers "does THIS
# COMMIT pass" rather than "does my tree pass". Local dev state (Debug
# outputs, stray files, another agent's uncommitted edits) has masked real
# failures here more than once.
#
# A pass is recorded under $SAGEFS_GATE_HOME/passed/<sha>/: the trust ledger,
# the trust report table and the release bundle. The pre-push hook refuses
# to push master to a commit with no pass. The self-hosted "main build" job
# promotes that bundle instead of rebuilding it; with no pass (someone
# bypassed the hook) it runs this same gate first. There is one gate and one
# definition of "passed", and nothing waits on a GitHub-hosted runner.
set -uo pipefail

STATE=${SAGEFS_GATE_HOME:-$HOME/.local/share/sagefs-gate}
REPO=$(git -C "$(dirname "$0")" rev-parse --show-toplevel) || exit 9
mkdir -p "$STATE/passed" "$STATE/logs"

passed_dir() { echo "$STATE/passed/$1"; }

if [ "${1:-}" = "--promote" ]; then
  sha=$(git -C "$REPO" rev-parse "$2") || exit 9
  out=$3
  [ -f "$(passed_dir "$sha")/ok" ] || { echo "local-gate: $sha has no pass to promote"; exit 1; }
  mkdir -p "$out"
  cp "$(passed_dir "$sha")"/release/* "$out"/
  if [ -n "${GITHUB_STEP_SUMMARY:-}" ] && [ -f "$(passed_dir "$sha")/trust-report.md" ]; then
    cat "$(passed_dir "$sha")/trust-report.md" >> "$GITHUB_STEP_SUMMARY"
  fi
  echo "local-gate: promoted the gated bundle for $sha"
  ls -la "$out"
  exit 0
fi

force=0
if [ "${1:-}" = "--force" ]; then force=1; shift; fi
sha=$(git -C "$REPO" rev-parse "${1:-HEAD}^{commit}") || exit 9
short=${sha:0:8}

if [ $force = 0 ] && [ -f "$(passed_dir "$sha")/ok" ]; then
  echo "local-gate: $short already passed ($(cat "$(passed_dir "$sha")/ok"))"
  exit 0
fi

# Kill a process and everything it spawned, children first. The gate's tree is
# dotnet fsi -> test processes -> daemons and FSI hosts, and a daemon outlives
# its parent by design, so killing only the top of the tree leaks processes
# that still hold the test ports. Walks by PID rather than by name: a `pkill
# -f` pattern here would match this script's own command line.
kill_tree() {
  local pid=$1 kid
  for kid in $(pgrep -P "$pid" 2>/dev/null); do kill_tree "$kid"; done
  kill -TERM "$pid" 2>/dev/null || true
}

# One gate at a time on this machine, and the NEWEST one wins. A manual gate
# and the runner's fallback must never share the checkout, the build output or
# the test ports.
#
# Superseding rather than queueing, because an older gate is validating a
# commit we are no longer shipping: its verdict is already worthless, and
# waiting for it just pays for that worthlessness in wall clock — twice, since
# the machine is saturated the whole time. The one exception is a gate already
# running THIS commit, which is doing your work for you.
exec 9>"$STATE/lock"
if ! flock -n 9; then
  running_pid=$(cut -d' ' -f1 "$STATE/current" 2>/dev/null || true)
  running_sha=$(cut -d' ' -f2 "$STATE/current" 2>/dev/null || true)
  if [ -n "$running_sha" ] && [ "$running_sha" = "$sha" ]; then
    echo "local-gate: $short is already being gated; waiting for that run"
    flock 9
    if [ $force = 0 ] && [ -f "$(passed_dir "$sha")/ok" ]; then
      echo "local-gate: $short passed while waiting"
      exit 0
    fi
  else
    echo "local-gate: superseding the gate for ${running_sha:0:8} — this run gates $short"
    if [ -n "$running_pid" ] && kill -0 "$running_pid" 2>/dev/null; then
      kill_tree "$running_pid"
      # TERM first so a tier can flush its log, then insist. The lock is held
      # until that process actually dies, so this loop is also what we wait on.
      for _ in $(seq 1 40); do
        kill -0 "$running_pid" 2>/dev/null || break
        sleep 0.5
      done
      kill -KILL "$running_pid" 2>/dev/null || true
    fi
    flock 9
  fi
fi
# Own the lock: publish who we are so the next gate can supersede us the same
# way. Written after the lock, never before, or a crashed starter would leave a
# pid that a newcomer would try to kill.
echo "$$ $sha" > "$STATE/current"

# A persistent clean checkout per source repo, on real disk (a Release build is
# several GB and the integration suites write temp dirs; a tmpfs has filled
# and hung this before). Persistent means bin/obj, node_modules, the MCP SDK
# clone and the Harmony nupkg stay warm between runs. git clean without -x
# keeps ignored build output while removing every untracked source file.
WT="$STATE/checkout-$(echo -n "$REPO" | sha1sum | cut -c1-8)"
if [ ! -d "$WT/.git" ] && [ ! -f "$WT/.git" ]; then
  git -C "$REPO" worktree add --detach "$WT" "$sha" -q || exit 9
fi
cd "$WT" || exit 9
git checkout --detach -q "$sha" || exit 9
git reset --hard -q
git clean -fdq

export SAGEFS_DATA_DIR="$STATE/data"   # never the user's real ~/.SageFs
export TMPDIR="$STATE/tmp"
rm -rf "$SAGEFS_DATA_DIR" "$TMPDIR"; mkdir -p "$SAGEFS_DATA_DIR" "$TMPDIR"
export SOURCE_SHA="$sha"
# MSBuild reuse nodes outlive the build that spawned them (about 15 minutes
# idle). They used to inherit the lock fd below and hold it the whole time,
# so the next gate sat at "another gate is running" behind a gate that had
# already finished. Two fixes: no reuse nodes, and the pipeline runs with fd 9
# closed so nothing it spawns can ever carry the lock.
export MSBUILDDISABLENODEREUSE=1
# Recorded tier durations persist across gates, so longest-first ordering
# learns from every run.
export SAGEFS_TIER_HISTORY="$STATE/tier-durations.json"
# Per-suite seconds, for balancing the sharded host tier (TierPlan.assign).
export SAGEFS_SUITE_HISTORY="$STATE/suite-durations.json"
log="$STATE/logs/$short.log"

echo "=== local gate: $(git log --oneline -1) ==="
echo "    log: $log"
start=$(date +%s)
# Full output to the log; progress (stage boundaries, one line per finished
# tier, failures) to the console as it happens.
dotnet fsi ci-pipeline.fsx -- ci release 9>&- 2>&1 | tee "$log" \
  | grep --line-buffered -aE '^── tier|STAGE #|^Tiers:|^Expected wall|trust report:|^\| |error' \
  | sed -u 's/\x1b\[[0-9;]*[A-Za-z]//g'
code=${PIPESTATUS[0]}
elapsed=$(( $(date +%s) - start ))

report="$WT/test-results/trust-report.md"
echo
if [ $code -ne 0 ]; then
  echo "=== local gate FAILED for $short after $((elapsed / 60))m$((elapsed % 60))s (exit $code) ==="
  grep -aE '^\s*(──|::error)|STAGE .* (failed|finished)|error ' "$log" | sed 's/\x1b\[[0-9;]*[A-Za-z]//g' | tail -15
  exit $code
fi

dest=$(passed_dir "$sha")
rm -rf "$dest"; mkdir -p "$dest/release"
cp release/* "$dest/release/"
cp test-results/trust-ledger.jsonl "$dest/" 2>/dev/null
cp "$report" "$dest/" 2>/dev/null
echo "$(date -Iseconds) in $((elapsed / 60))m$((elapsed % 60))s" > "$dest/ok"
echo "=== local gate PASSED for $short in $((elapsed / 60))m$((elapsed % 60))s ==="
