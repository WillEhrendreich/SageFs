#!/usr/bin/env bash
# scripts/lemmings/run-lemming <fixture> <task> <model> <run-id> [max-turns]
#
# One disposable onboarding trial: a cheap model, given only what a new user has
# (the project, the SageFs MCP server registered the way the README says, and the
# SageFs skill installed the way the README says), does a first task. Nothing in
# the prompt or the workspace hints at how SageFs works.
#
#   fixture   a directory under scripts/lemmings/fixtures
#   task      a file under scripts/lemmings/tasks
#   model     a Claude Code model alias or id (haiku, sonnet, ...)
#   run-id    names the run directory; reruns must use a new id
#
# Isolation, and what it does and does not guarantee:
#   - The agent runs under bubblewrap. It can read and write only its own run
#     directory and the toolchain (dotnet, the tool store, mise installs, the nuget
#     cache). It cannot see the rest of the home directory, this repo, or any other
#     run, so a broad glob cannot reach a sibling fixture or the real source.
#   - Its Claude Code config is an empty directory plus the credentials file, with
#     project settings only, CLAUDE.md discovery and auto-memory off, and only the
#     project's MCP config. No user hooks, skills, plugins or memory.
#   - The SageFs daemon is the published tool, started by `sagefs mcp` exactly as
#     a new user's client would, on its own port and its own data directory. It is
#     never the daemon on 37749.
#   - Teardown is graceful first (`sagefs stop`), forced only if that fails, and
#     the two are recorded separately.
#   - Network is NOT isolated: the model API and localhost are reachable.
set -euo pipefail

FIXTURE=${1:?fixture} TASK=${2:?task} MODEL=${3:?model} ID=${4:?run-id} TURNS=${5:-60}
HERE=$(cd "$(dirname "$0")" && pwd)
REPO=$(cd "$HERE/../.." && pwd)
RUN=/tmp/lem/$ID
[ -e "$RUN" ] && { echo "run $ID already exists: pick a new id" >&2; exit 2; }
W=$RUN/w CFG=$RUN/cfg DATA=$RUN/data OUT=$RUN/out
mkdir -p "$W" "$CFG" "$DATA" "$OUT" "$RUN/dotnethome"

# The workspace: the fixture, the skill installed where a user installs it, and the
# MCP registration a user would write.
cp -r --reflink=auto "$HERE/fixtures/$FIXTURE/." "$W/"
mkdir -p "$W/.claude/skills"
cp -r --reflink=auto "$REPO/skills/sagefs" "$W/.claude/skills/sagefs"

free_port() {
  for _ in $(seq 1 200); do
    p=$((38200 + RANDOM % 600))
    ss -ltn "( sport = :$p or sport = :$((p + 1)) )" | grep -q LISTEN || { echo "$p"; return; }
  done
  echo "no free port pair" >&2; return 1
}
PORT=$(free_port)
cat > "$W/.mcp.json" <<JSON
{ "mcpServers": { "sagefs": { "command": "sagefs", "args": ["mcp"],
  "env": { "SAGEFS_MCP_PORT": "$PORT", "SAGEFS_DATA_DIR": "$DATA" } } } }
JSON

# What the fixture looked like before, so the harness can prove what changed.
snapshot() { (cd "$W" && find . -type f -not -path './.claude/*' -not -path '*/bin/*' -not -path '*/obj/*' -not -name '.mcp.json' -print0 | sort -z | xargs -0 sha256sum); }
snapshot > "$OUT/files.before"

PROMPT=$(cat "$HERE/tasks/$TASK")
START=$(date +%s)

set +e
bwrap --die-with-parent \
  --ro-bind /usr /usr --ro-bind /etc /etc \
  --symlink usr/bin /bin --symlink usr/sbin /sbin --symlink usr/lib /lib --symlink usr/lib64 /lib64 \
  --ro-bind /run/systemd/resolve /run/systemd/resolve \
  --proc /proc --dev /dev --tmpfs /tmp --tmpfs "$HOME" \
  --ro-bind "$HOME/.dotnet" "$HOME/.dotnet" \
  --ro-bind "$HOME/.local/share/mise" "$HOME/.local/share/mise" \
  --bind "$HOME/.nuget" "$HOME/.nuget" \
  --bind "$RUN" "$RUN" \
  --bind "$HOME/.claude/.credentials.json" "$CFG/.credentials.json" \
  --chdir "$W" \
  --setenv HOME "$HOME" \
  --setenv DOTNET_ROOT "$HOME/.dotnet" \
  --setenv DOTNET_CLI_HOME "$RUN/dotnethome" \
  --setenv DOTNET_CLI_TELEMETRY_OPTOUT 1 --setenv DOTNET_NOLOGO 1 --setenv DOTNET_SKIP_FIRST_TIME_EXPERIENCE 1 \
  --setenv PATH "$HOME/.dotnet:$HOME/.dotnet/tools:$HOME/.local/share/mise/installs/claude/latest:$HOME/.local/share/mise/installs/node/26.7.0/bin:/usr/bin:/bin" \
  --setenv CLAUDE_CONFIG_DIR "$CFG" \
  --setenv CLAUDE_CODE_DISABLE_CLAUDE_MDS 1 --setenv CLAUDE_CODE_DISABLE_AUTO_MEMORY 1 \
  timeout 1500 claude -p "$PROMPT" \
    --model "$MODEL" --max-turns "$TURNS" --max-budget-usd 4 \
    --output-format stream-json --verbose \
    --strict-mcp-config --mcp-config "$W/.mcp.json" \
    --setting-sources project --no-session-persistence \
    --dangerously-skip-permissions \
  > "$OUT/events.ndjson" 2> "$OUT/claude.stderr"
CLAUDE_EXIT=$?
set -e
END=$(date +%s)

# Residue: what the agent left running, read BEFORE any teardown.
dash=$((PORT + 1))
curl -s --max-time 5 "http://localhost:$dash/api/sessions" > "$OUT/residue.sessions.json" 2>/dev/null || echo 'null' > "$OUT/residue.sessions.json"

# Teardown, graceful first.
GRACEFUL=unknown
if SAGEFS_MCP_PORT=$PORT SAGEFS_DATA_DIR=$DATA timeout 60 sagefs stop > "$OUT/stop.out" 2>&1; then GRACEFUL=stopped; else GRACEFUL=stop-failed; fi
sleep 2
FORCED=no
if ss -ltn "( sport = :$PORT or sport = :$dash )" | grep -q LISTEN; then
  FORCED=yes
  ss -ltnp "( sport = :$PORT or sport = :$dash )" | grep -o 'pid=[0-9]*' | cut -d= -f2 | sort -u | xargs -r kill
  sleep 2
fi

# Verification the harness does itself, outside the sandbox: never the model's claim.
snapshot > "$OUT/files.after"
diff "$OUT/files.before" "$OUT/files.after" > "$OUT/files.diff" || true
TESTS=skipped
if [ "$FIXTURE" = demoenv ]; then
  if (cd "$W" && timeout 300 dotnet run --project DemoEnv.Tests > "$OUT/verify.tests.out" 2>&1); then TESTS=pass; else TESTS=fail; fi
fi

"$HERE/score" "$OUT/events.ndjson" "$OUT/residue.sessions.json" \
  --id "$ID" --model "$MODEL" --exit "$CLAUDE_EXIT" --seconds "$((END - START))" \
  --graceful "$GRACEFUL" --forced "$FORCED" --tests "$TESTS" --diff "$OUT/files.diff" > "$OUT/summary.json"
cat "$OUT/summary.json"
