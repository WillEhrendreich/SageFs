#!/usr/bin/env bash
# scripts/lemmings/score <events.ndjson> <residue.sessions.json> --id ID --model M --exit N
#   --seconds N --graceful X --forced X --tests X --diff FILE
#
# Turns one run's event stream plus the harness's own checks into a summary.json.
# Everything here is read off the stream or measured by the harness. None of it is
# the model's claim about itself.
set -euo pipefail
EVENTS=$1 RESIDUE=$2; shift 2
ID= MODEL= EXIT= SECONDS_= GRACEFUL= FORCED= TESTS= DIFF=
while [ $# -gt 0 ]; do
  case $1 in
    --id) ID=$2;; --model) MODEL=$2;; --exit) EXIT=$2;; --seconds) SECONDS_=$2;;
    --graceful) GRACEFUL=$2;; --forced) FORCED=$2;; --tests) TESTS=$2;; --diff) DIFF=$2;;
  esac; shift 2
done

# grep exits 1 when the diff is empty, which under pipefail would fail the whole
# substitution; read the lines first, then build the array from whatever there is.
DIFF_LINES=$( { grep -E '^[<>]' "$DIFF" 2>/dev/null || true; } | sed -E 's/^[<>] [0-9a-f]+  //' | sort -u )
CHANGED=$(printf '%s\n' "$DIFF_LINES" | jq -R -s 'split("\n") | map(select(length > 0))')
RESIDUE_N=$(jq 'if type=="array" then length elif type=="object" then (.sessions // [] | length) else 0 end' "$RESIDUE" 2>/dev/null) || RESIDUE_N=null

jq -s \
  --arg id "$ID" --arg model "$MODEL" --argjson exit "${EXIT:-0}" --argjson seconds "${SECONDS_:-0}" \
  --arg graceful "$GRACEFUL" --arg forced "$FORCED" --arg tests "$TESTS" \
  --argjson changed "$CHANGED" --argjson residue "${RESIDUE_N:-null}" '
  def uses: [ .[] | select(.type=="assistant") | .message.content[]? | select(.type=="tool_use") ];
  def results: [ .[] | select(.type=="user") | .message.content[]? | select(.type=="tool_result") ];
  def bash: [ uses[] | select(.name=="Bash") | (.input.command // "") ];
  def text(c): if (c|type)=="string" then c else ([c[]? | (.text // "")] | join(" ")) end;
  (.[] | select(.type=="system" and .subtype=="init")) as $init
  | (.[] | select(.type=="result")) as $res
  | {
      id: $id, model: $model,
      outcome: ($res.subtype // "no-result-event"),
      claudeExit: $exit, seconds: $seconds,
      turns: ($res.num_turns // null), costUsd: ($res.total_cost_usd // null),
      isolation: {
        mcpServers: [ $init.mcp_servers[]? | "\(.name):\(.status)" ],
        toolCount: ($init.tools | length),
        nonSageFsMcpTools: [ $init.tools[]? | select(startswith("mcp__") and (startswith("mcp__sagefs__")|not)) ],
        skills: ($init.skills // []),
        plugins: ($init.plugins // [])
      },
      tools: (uses | group_by(.name) | map({ (.[0].name): length }) | add),
      sagefsCalls: ([ uses[] | select(.name|startswith("mcp__sagefs__")) | .name|sub("mcp__sagefs__";"") ]),
      firstEvalAtCall: ( [ uses[] | .name ] | to_entries | map(select(.value=="mcp__sagefs__send_fsharp_code")) | (.[0].key // null) ),
      bashDotnet: [ bash[] | select(test("dotnet (build|test|run|fsi|msbuild)")) ],
      bashSleeps: [ bash[] | select(test("(^|[ ;&|])sleep ")) ],
      bashOther: ([ bash[] | select(test("dotnet (build|test|run|fsi|msbuild)")|not) | select(test("(^|[ ;&|])sleep ")|not) ] | length),
      toolErrors: ([ results[] | select(.is_error==true) ] | length),
      firstErrors: ([ results[] | select(.is_error==true) | text(.content)[0:220] ] | .[0:4]),
      finalText: (($res.result // "")[0:900]),
      verification: { changedFiles: $changed, fixtureTests: $tests },
      residueSessionsBeforeTeardown: $residue,
      teardown: { graceful: $graceful, forced: $forced }
    }' "$EVENTS"
