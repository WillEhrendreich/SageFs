# A session for the DemoEnv test project, from the picker to Ready and active, at two sizes.
# The shared daemon shows other agents' sessions too; only the one under this run's directory is this tour's.
# Create Session has to make the new session this window's own: the status bar item names it by id with
# no Switch Session in between. It used to keep naming another session on a daemon that had one.
resize 1280 800
expect-text SageFs
wait 12
click SageFs
wait 2
command SageFs: Create Session
wait 2
shot picker-1280x800
key enter
wait 3
shot just-created-1280x800 --region sidebar --region statusbar
expect-session --within 240
expect-text --within 60 session {session}
# The Sessions row says it is the one this window uses and the one for this workspace, and gives
# its id, so it can be told from another agent's session without guessing from the label.
expect-text --within 30 active · this workspace · Ready
expect-text --within 5 · {session}
wait 3
shot active-1280x800 --region sidebar --region statusbar

resize 1024 700
wait 2
shot active-1024x700 --region sidebar --region statusbar
