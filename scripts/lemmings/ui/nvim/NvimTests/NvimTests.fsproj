<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the pure parts of the Neovim driver: the ANSI to HTML function (properties),
       the key notation, the shell allow-list, the tour parser (examples and a round trip).
       Run them with: dotnet run in this directory. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Expecto" />
    <PackageReference Include="Expecto.FsCheck" />
    <PackageReference Include="FsCheck" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Ansi.fs" />
    <Compile Include="../NvimShot.fs" />
    <Compile Include="../Nvim.fs" />
    <Compile Include="../NvimTour.fs" />
    <Compile Include="../NvimOracle.fs" />
    <Compile Include="AnsiTests.fs" />
    <Compile Include="OracleTests.fs" />
    <Compile Include="DriverTests.fs" />
    <Compile Include="TourTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
