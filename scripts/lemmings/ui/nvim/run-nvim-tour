#!/usr/bin/env bash
# scripts/lemmings/ui/nvim/run-nvim-tour <tour-file> [fixture] [open-file] [run-id]
#
# Runs a tour (see tours/ and Tour.fs) against a fresh Neovim on a fresh copy of a fixture, with
# no lemming: the same editor sandbox, the same shared SageFs daemon on 37749, numbered shots in
# <run-dir>/out/shots. A design reviewer reads those. The run directory is named
# tour-<tour>-<nn> under $LEM_ROOT, so its sessions are recognisable in the dashboard.
#
#   fixture     a directory under scripts/lemmings/fixtures (default demoenv)
#   open-file   the file Neovim opens on, relative to the fixture (default DemoEnv/DemoEnv.fs)
#
# The daemon is never started, stopped or reconfigured here. Sessions the tour created are read
# from the daemon first and then stopped by exact id, only those under this run directory.
set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
LEMMINGS=$(cd "$HERE/../.." && pwd)
source "$LEMMINGS/lib-cmd.sh"
source "$HERE/lib-nvim.sh"

TOUR=${1:?tour-file} FIXTURE=${2:-demoenv} OPEN=${3:-DemoEnv/DemoEnv.fs} ID=${4:-auto}
[ -f "$TOUR" ] || { echo "no tour file: $TOUR" >&2; exit 2; }
NAME=$(basename "$TOUR" .tour)
[ -d "$LEMMINGS/fixtures/$FIXTURE" ] || { echo "no fixture: $FIXTURE" >&2; exit 2; }

NVIM_BIN=${SAGEFS_LEMMING_NVIM:-$LEM_NVIM_DEFAULT_BIN}
PLUGIN_DIR=${SAGEFS_LEMMING_NVIM_PLUGIN:-$LEM_PLUGIN_DEFAULT_DIR}
[ -x "$NVIM_BIN" ] || { echo "no nvim at $NVIM_BIN" >&2; exit 4; }
[ -f "$PLUGIN_DIR/lua/sagefs/init.lua" ] || { echo "no sagefs.nvim at $PLUGIN_DIR" >&2; exit 4; }
command -v tmux > /dev/null || { echo "tmux is required" >&2; exit 4; }

if [ "$ID" = auto ]; then
  n=1
  while [ -e "$LEM_ROOT/tour-$NAME-$(printf '%02d' "$n")" ]; do n=$((n + 1)); done
  ID=tour-$NAME-$(printf '%02d' "$n")
fi
RUN=$LEM_ROOT/$ID
[ -e "$RUN" ] && { echo "run $ID already exists: pick a new id" >&2; exit 2; }
W=$RUN/w OUT=$RUN/out
LABEL=lem-$ID
LEM_OPEN_FILE=$W/$OPEN

lem_use_shared_daemon
mkdir -p "$W" "$OUT"
echo "tour $ID: $NAME on $FIXTURE; dashboard http://localhost:${LEM_DASH_PORT}/dashboard (working directory $W)" >&2

cp -r --reflink=auto "$LEMMINGS/fixtures/$FIXTURE/." "$W/"
git -C "$W" init -q
git -C "$W" config user.name tour
git -C "$W" config user.email tour@lem.invalid
git -C "$W" config commit.gpgsign false
git -C "$W" add -- .
git -C "$W" commit -q -m "tour baseline"

lem_nvim_ensure_drive
lem_nvim_stage no
lem_start_editor_sandbox
cleanup_editor() { lem_stop_editor_sandbox; }
trap 'cleanup_editor' EXIT

set +e
DOTNET_NOLOGO=1 dotnet "$DRIVE_DLL" nvim tour "$TOUR" \
  --tmux-dir "$OUT/tmux" --label "$LABEL" --out "$OUT" --workspace "$W" \
  --nvim "$NVIM_BIN" --init "$OUT/ui/init.lua" --open "$LEM_OPEN_FILE" \
  2>&1 | tee "$OUT/tour.out"
TOUR_EXIT=${PIPESTATUS[0]}
set -e

cleanup_editor
trap - EXIT
lem_cleanup_sessions "$W"
echo "tour $ID finished (exit $TOUR_EXIT): shots in $OUT/shots, cleanup ${LEM_CLEANUP:-unknown}" >&2
exit "$TOUR_EXIT"
