<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Neovim half of LemDrive, buildable on its own. It produces LemDrive.dll so a
       lemming types the same `dotnet LemDrive.dll nvim <command>` either way. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>LemDrive</AssemblyName>
    <RootNamespace>LemDrive</RootNamespace>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Nvim.fs" />
    <Compile Include="NvimOracle.fs" />
    <Compile Include="NvimMain.fs" />
  </ItemGroup>

</Project>
