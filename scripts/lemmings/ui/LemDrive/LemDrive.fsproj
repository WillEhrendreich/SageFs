<Project Sdk="Microsoft.NET.Sdk">

  <!-- LemDrive: the one typed command line a lemming (or the harness) uses to
       drive an editor. `dotnet LemDrive.dll vsc <command>` drives VS Code over
       CDP; the Neovim commands live in Nvim.fs beside it. Standalone, like
       SageFs.Demos: it must not reference SageFs.Core, so a daemon rebuild
       cannot change a running trial. Playwright comes through central package
       management, the same package SageFs.Tests already uses. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <LangVersion>preview</LangVersion>
    <AssemblyName>LemDrive</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Outcome.fs" />
    <Compile Include="Chord.fs" />
    <Compile Include="Guard.fs" />
    <Compile Include="VscCommand.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
