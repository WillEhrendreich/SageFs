#!/usr/bin/env bash
# scripts/lemmings/run-ui-lemming <editor> <task> <model> [max-turns]
#
# One disposable trial where a Command Code lemming on a FREE model drives a real editor that has
# the SageFs plugin, as a client of the ONE shared SageFs daemon on 37749. This file only picks
# the runner for the editor. Each editor's runner is its own file, so the two never share code
# that could break the other:
#
#   vscode   scripts/lemmings/ui/vscode/run-vscode-lemming   VS Code on Xvfb, driven over CDP
#   nvim     scripts/lemmings/ui/nvim/run-nvim-lemming       Neovim in tmux, driven with keys
#
# <task> is a file under the editor's tasks directory, without .md (ui-eval, ui-edit-reeval,
# ui-live-tests, ui-hot-reload, ui-find-help). <model> must be marked FREE in the live
# `cmdc --list-models`; anything else is refused before anything starts.
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)

usage() {
  echo "usage: run-ui-lemming <vscode|nvim> <task> <model> [max-turns]" >&2
  exit 2
}

# ---- VS Code ---------------------------------------------------------------------------------
run_vscode() { exec "$HERE/ui/vscode/run-vscode-lemming" "$@"; }

# ---- Neovim ----------------------------------------------------------------------------------
run_nvim() { exec "$HERE/ui/nvim/run-nvim-lemming" "$@"; }

[ $# -ge 3 ] || usage
EDITOR_NAME=$1; shift
case $EDITOR_NAME in
  vscode | vsc) run_vscode "$@" ;;
  nvim | neovim) run_nvim "$@" ;;
  *) echo "run-ui-lemming: unknown editor '$EDITOR_NAME' (vscode or nvim)" >&2; usage ;;
esac
