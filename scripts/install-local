#!/usr/bin/env bash
# scripts/install-local [<commit>] [--build] [--force]   make the daemon you use the build of <commit>
# scripts/install-local --status                         say how far the running daemon is behind master
#
# The daemon this machine runs must be the build the work is done against. A daemon that lags the code
# costs signal twice: a session that loads a newer SageFs.Core than the daemon refuses with a version
# mismatch, and a fix that is merged but not running looks like a fix that does not work. So the build
# is installed and the daemon restarted as part of the workflow, not as an afterthought.
#
#   <commit>    default HEAD. With a gate pass, the nupkg the gate itself built for that commit is installed
#               (the exact bytes CI will publish). Without one, pass --build to pack the working tree.
#   --build     pack the checkout at <commit> with a unique local version suffix (NuGet serves a stale
#               cached package for a reused version, so the version always changes) and install that.
#   --force     restart even when sessions are open on the daemon (they are dropped and not resumed).
#
# Steps, each fatal on failure: refuse on a dirty tree or open sessions, install the package as the global
# tool, stop the old daemon, start the new one detached, wait for it with a hard timeout, and prove it is
# the build asked for by reading its version back. Records what is installed so --status can tell skew.
set -euo pipefail
REPO=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
STATE=${SAGEFS_GATE_HOME:-$HOME/.local/share/sagefs-gate}
MARK_DIR=${SAGEFS_INSTALL_STATE:-$HOME/.local/state/sagefs-install}
MCP_PORT=${SAGEFS_MCP_PORT:-37749}
START_TIMEOUT_SECONDS=90
STOP_TIMEOUT_SECONDS=30
mkdir -p "$MARK_DIR"

say() { echo "install-local: $*"; }
die() { echo "install-local: $*" >&2; exit "${2:-1}"; }
sessions_json() { curl -s -m 5 "http://localhost:$MCP_PORT/api/sessions" || true; }
daemon_up() { curl -s -m 3 -o /dev/null "http://localhost:$MCP_PORT/health"; }

if [ "${1:-}" = "--status" ]; then
  installed=$(cat "$MARK_DIR/sha" 2>/dev/null || true)
  running=$(sagefs status 2>/dev/null | grep -oiE 'v?[0-9]+\.[0-9]+\.[0-9]+[^ ]*' | head -1 || true)
  head_ver=$(git -C "$REPO" show HEAD:Directory.Build.props | grep -oP '(?<=<Version>)[^<]+' || true)
  if [ -z "$installed" ]; then
    say "no install recorded by this script. Running daemon: ${running:-not running}. Master is at $head_ver."
    exit 2
  fi
  behind=$(git -C "$REPO" rev-list --count "$installed..master" 2>/dev/null || echo "?")
  say "installed ${installed:0:8} ($(cat "$MARK_DIR/version")), running: ${running:-not running}, master is $behind commits ahead"
  [ "$behind" = 0 ] || exit 2
  exit 0
fi

sha_arg=""; build=no; force=no
for a in "$@"; do
  case $a in
    --build) build=yes ;;
    --force) force=yes ;;
    -*) die "unknown option $a" 64 ;;
    *) sha_arg=$a ;;
  esac
done
sha=$(git -C "$REPO" rev-parse "${sha_arg:-HEAD}^{commit}")
short=${sha:0:8}
version=$(git -C "$REPO" show "$sha:Directory.Build.props" | grep -oP '(?<=<Version>)[^<]+' | head -1)
[ -n "$version" ] || die "could not read the version at $short"

# 1. Where the package comes from.
gated="$STATE/passed/$sha/release/SageFs.$version.nupkg"
if [ -f "$gated" ] && [ "$build" = no ]; then
  pkg_dir=$(dirname "$gated"); install_version=$version
  say "using the nupkg the gate built for $short ($version)"
else
  [ "$build" = yes ] || die "no gate pass for $short, so no gated package. Run scripts/local-gate $short, or pass --build to pack this checkout." 3
  [ "$sha" = "$(git -C "$REPO" rev-parse HEAD)" ] || die "--build packs the checkout, which is not at $short" 3
  [ -z "$(git -C "$REPO" status --porcelain --untracked-files=no)" ] || die "tracked files have uncommitted changes; commit or stash them so the package matches $short" 3
  install_version="$version-local.$short"
  pkg_dir="$MARK_DIR/pack-$short"; rm -rf "$pkg_dir"; mkdir -p "$pkg_dir"
  say "packing $short as $install_version"
  (cd "$REPO" && nice -n 10 dotnet pack SageFs -c Release -o "$pkg_dir" -p:Version="$install_version" --nologo -v q) \
    || die "dotnet pack failed" 4
fi

# 2. Do not drop somebody's work unasked.
open=$(sessions_json | grep -o '"id"' | wc -l || true)
if [ "$open" -gt 0 ] && [ "$force" = no ]; then
  sessions_json | head -c 1200 >&2; echo >&2
  die "the daemon has $open open session(s). They would be dropped. Rerun with --force when that is fine." 5
fi

# 3. Install, 4. stop, 5. start, 6. verify.
say "installing sagefs $install_version as the global tool"
dotnet tool update --global sagefs --add-source "$pkg_dir" --version "$install_version" >/dev/null 2>&1 \
  || dotnet tool install --global sagefs --add-source "$pkg_dir" --version "$install_version" >/dev/null \
  || die "dotnet tool install failed" 4
tool_version=$(sagefs --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+[^ ]*' | head -1 || true)
case "$tool_version" in "${version}"*) ;; *) die "installed tool reports '$tool_version', not $version" 4 ;; esac

if daemon_up; then
  say "stopping the running daemon"
  timeout "$STOP_TIMEOUT_SECONDS" sagefs stop >/dev/null 2>&1 || true
  for _ in $(seq 1 "$STOP_TIMEOUT_SECONDS"); do daemon_up || break; sleep 1; done
  daemon_up && die "the old daemon is still answering on $MCP_PORT after ${STOP_TIMEOUT_SECONDS}s; stop it (sagefs stop, then check the process) and rerun" 6
fi

say "starting the new daemon"
log="$MARK_DIR/daemon-$short.log"
setsid nohup sagefs --no-resume > "$log" 2>&1 < /dev/null &
up=no
for _ in $(seq 1 "$START_TIMEOUT_SECONDS"); do daemon_up && { up=yes; break; }; sleep 1; done
[ "$up" = yes ] || die "the new daemon did not answer on $MCP_PORT within ${START_TIMEOUT_SECONDS}s; log: $log" 7

running=$(sagefs status 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+[^ ]*' | head -1 || true)
case "$running" in "${version}"*) ;; *) die "the daemon that answered reports '${running:-nothing}', not $version; log: $log" 7 ;; esac

printf '%s\n' "$sha" > "$MARK_DIR/sha"; printf '%s\n' "$install_version" > "$MARK_DIR/version"
say "daemon is $running ($short), answering on $MCP_PORT. Log: $log"
