<Project Sdk="Microsoft.NET.Sdk">

  <!-- Minimal compiled Expecto project for SageFs.Tests/McpToolOutcomeTests.fs
       (outcome-gate-sweep.md Island D, Gap D). Deliberately its own project,
       not samples/from-csharp/SageFs.Samples.FromCSharp: HttpApiIntegrationTests.fs
       already edits that project's Hello.fs on disk in its own "compiled live
       testing" cell, and Expecto can run different test files' [<Tests>]
       values in parallel — a second integration cell mutating the same file
       concurrently would race. Nothing else in the repo references this
       project. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Sample.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

</Project>
