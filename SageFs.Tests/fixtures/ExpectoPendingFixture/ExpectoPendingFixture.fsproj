<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiled Expecto project for SageFs.Tests/ExpectoPendingOutcomeTests.fs:
       two passing tests and one pending test (ptest). Its own project so no other
       gate's expectations about test counts depend on it. Nothing else in the repo
       references it. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Sample.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

</Project>
