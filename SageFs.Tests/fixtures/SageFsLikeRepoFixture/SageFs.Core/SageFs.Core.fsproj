<Project Sdk="Microsoft.NET.Sdk">
  <!-- A tiny stand-in for SageFs.Core, in a tiny stand-in for the SageFs repo: a project whose
       AssemblyName is SageFs.Core, next to a project that references it.
       It has an API the daemon's real SageFs.Core does not (SageFs.FixtureOnly), which is the whole
       point: a session on Consumer has to compile against THIS Core, the one its repo builds, and
       not the daemon's older one. SageFs.Tests/SelfHostCoreOutcomeTests.fs copies this folder to a
       temp directory and builds it there, so nothing in the repo tree is touched. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SageFs.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="FixtureOnly.fs" />
  </ItemGroup>
</Project>
