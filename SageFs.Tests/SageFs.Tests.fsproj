    <ItemGroup>
        <PackageReference Include="Expecto" />
        <PackageReference Include="Expecto.FsCheck" />
        <PackageReference Include="Expecto.Hopac" />
        <PackageReference Include="FsCheck" />
        <PackageReference Include="YoloDev.Expecto.TestSdk" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="SageFs.Harmony" />
        <PackageReference Include="Fantomas.Core" />
        <PackageReference Include="Falco" />
        <PackageReference Include="Falco.Markup" />
        <PackageReference Include="FSharp.SystemTextJson" />
        <PackageReference Include="Verify.Expecto" />
        <PackageReference Include="Microsoft.Playwright" />
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="snapshots\**\*.verified.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SageFs.Core\SageFs.Core.fsproj" />
        <ProjectReference Include="..\SageFs.Simulation\SageFs.Simulation.fsproj" />
        <ProjectReference Include="..\SageFs\SageFs.fsproj" />
        <ProjectReference Include="..\SageFs.Host\SageFs.Host.fsproj" />
        <!-- The web-app hot-reload fixture is a build-time dependency: the
             host process #loads its source and needs the fixture's compiled
             bin/ assemblies to resolve references. Reference with
             ReferenceOutputAssembly=false so the fixture DLL is built (and its
             bin/ populated) without polluting the test project's references. -->
        <ProjectReference Include="fixtures\WebAppFixture\WebAppFixture.fsproj"
                          Condition="'$(TargetFramework)' == 'net11.0'"
                          PrivateAssets="all"
                          ReferenceOutputAssembly="false" />
        <!-- #141/#142's outcome gate needs a REAL compiled project with no package references (the SDK's
             implicit FSharp.Core — the config every normal user is in, and SageFs's own dogfood tests
             never exercise since SageFs.Tests.fsproj references SageFs.Core). Same
             ReferenceOutputAssembly="false" pattern: built so a session can load it, never linked into
             this test project's own references. -->
        <ProjectReference Include="fixtures\FSharpCoreIdentityFixture\FSharpCoreIdentityFixture.fsproj"
                          PrivateAssets="all"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- The [Integration] SessionManager lifecycle suite drives the REAL
         SessionManager in-process, which spawns the FSI host from
         AppContext.BaseDirectory/host/ (Args.hostExePath) — the daemon's
         layout. Mirror that layout in the test output so the suite spawns the
         freshly built host instead of failing on a missing host/ dir. -->
    <Target Name="CopyHostForInProcessSessionManager" AfterTargets="Build">
        <ItemGroup>
            <TestHostFiles Include="..\SageFs.Host\bin\$(Configuration)\$(TargetFramework)\**\*"
                           Exclude="..\SageFs.Host\bin\$(Configuration)\$(TargetFramework)\**\*.runtimeconfig.dev.json" />
        </ItemGroup>
        <!-- Empty host/ first: the host refuses to start (fail-closed manifest
             check) if a retired file from a previous build is still here. -->
        <RemoveDir Directories="$(OutDir)host" />
        <Copy SourceFiles="@(TestHostFiles)"
              DestinationFiles="@(TestHostFiles->'$(OutDir)host\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>

</Project>
