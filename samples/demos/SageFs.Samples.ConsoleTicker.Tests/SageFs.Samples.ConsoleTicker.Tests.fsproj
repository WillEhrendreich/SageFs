<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TickerTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicit FSharp.Core ensures the repo-pinned version wins over Expecto's own transitive reference. -->
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Expecto" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SageFs.Samples.ConsoleTicker/SageFs.Samples.ConsoleTicker.fsproj" />
  </ItemGroup>

</Project>
