<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PackAsTool>true</PackAsTool>
        <IsPackable>true</IsPackable>
        <ToolCommandName>sagefs</ToolCommandName>
        <PackageOutputPath>./nupkg</PackageOutputPath>

        <!-- NuGet config -->
        <PackageId>SageFs</PackageId>
        <Authors>Will Ehrendreich</Authors>
        <Description>SageFs — a functional F# REPL, MCP server, and live web development environment.</Description>
        <Copyright>Copyright © 2025-2026 Will Ehrendreich</Copyright>
        <PackageTags>fsharp;functional;repl;interactive;shell;asp.net core;mcp;dashboard;sagefs</PackageTags>
        <PackageProjectUrl>https://github.com/WillEhrendreich/SageFs</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>Readme.md</PackageReadmeFile>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/WillEhrendreich/SageFs</RepositoryUrl>

        <!-- The daemon and the FSI host both run net10.0 (repo default).
             All host-copy/pack globs use HostTargetFramework so there is
             exactly one place to change the host TFM if it ever diverges. -->
        <HostTargetFramework>net10.0</HostTargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SageFs.Tests" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="dashboard.css" />
        <EmbeddedResource Include="datastar.js" />
        <EmbeddedResource Include="Resources\devreload.js" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="DaemonState.fs" />
        <!-- The daemon's Elm kernel + render stack (moved out of SageFs.Core so the
             FSI host closure ships the session engine only). Order is dependency-driven:
             leaves first, SageFsApp/ElmDaemon last. -->
        <Compile Include="RenderPipeline.fs" />
        <Compile Include="PipelineFlame.fs" />
        <Compile Include="CellGrid.fs" />
        <Compile Include="Theme.fs" />
        <Compile Include="ThemePresets.fs" />
        <Compile Include="SyntaxHighlight.fs" />
        <Compile Include="Draw.fs" />
        <Compile Include="AnsiEmitter.fs" />
        <Compile Include="DaemonClient.fs" />
        <Compile Include="Editor.fs" />
        <Compile Include="ElmLoop.fs" />
        <Compile Include="SessionDisplay.fs" />
        <Compile Include="SageFsEvent.fs" />
        <Compile Include="TestsPane.fs" />
        <Compile Include="SageFsApp.fs" />
        <Compile Include="ElmDaemon.fs" />
        <Compile Include="TerminalUI.fs" />
        <Compile Include="JumpToTest.fs" />
        <Compile Include="Screen.fs" />
        <Compile Include="DirectoryConfig.fs" />
        <Compile Include="ConnectionTracker.fs" />
        <Compile Include="DashboardTypes.fs" />
    <Compile Include="DashboardFragments.fs" />
        <Compile Include="Dashboard.fs" />
        <Compile Include="McpPushNotifications.fs" />
        <Compile Include="McpStateHandlers.fs" />
        <Compile Include="SessionEvents.fs" />
        <Compile Include="JupyterKernel.fs" />
        <Compile Include="Mcp.fs" />
        <Compile Include="McpTools.fs" />
        <Compile Include="McpServer.fs" />
        <Compile Include="DaemonMode.fs" />
        <Compile Include="WatchdogRunner.fs" />
        <Compile Include="JupyterTransport.fs" />
        <Compile Include="EnvCheck.fs" />
        <Compile Include="Program.fs" />
        <None Include="..\Readme.md">
          <Pack>true</Pack>
          <PackagePath>/</PackagePath>
          <Link>Readme.md</Link>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SageFs.Core\SageFs.Core.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Falco" />
        <PackageReference Include="Falco.Datastar" />
        <PackageReference Include="Falco.Markup" />
        <PackageReference Include="OpenTelemetry.Exporter.Console" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />    
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />        
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
        <PackageReference Include="Serilog.Extensions.Logging.File" />
        <PackageReference Include="FSharp.SystemTextJson" />
        <PackageReference Include="FSharp.Data.Adaptive" />
        <PackageReference Include="ModelContextProtocol" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" />
        <PackageReference Include="NetMQ" />
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\runtimes\win-x64\native\tree-sitter-fsharp.dll"
              Pack="true"
              PackagePath="runtimes\win-x64\native"
              CopyToOutputDirectory="PreserveNewest"
              Link="runtimes\win-x64\native\tree-sitter-fsharp.dll" />
        <None Include="..\runtimes\osx-arm64\native\libtree-sitter-fsharp.dylib"
              Condition="Exists('..\runtimes\osx-arm64\native\libtree-sitter-fsharp.dylib')"
              Pack="true"
              PackagePath="runtimes\osx-arm64\native"
              CopyToOutputDirectory="PreserveNewest"
              Link="runtimes\osx-arm64\native\libtree-sitter-fsharp.dylib" />
        <None Include="..\runtimes\osx-x64\native\libtree-sitter-fsharp.dylib"
              Condition="Exists('..\runtimes\osx-x64\native\libtree-sitter-fsharp.dylib')"
              Pack="true"
              PackagePath="runtimes\osx-x64\native"
              CopyToOutputDirectory="PreserveNewest"
              Link="runtimes\osx-x64\native\libtree-sitter-fsharp.dylib" />
        <None Include="..\runtimes\linux-x64\native\libtree-sitter-fsharp.so"
              Condition="Exists('..\runtimes\linux-x64\native\libtree-sitter-fsharp.so')"
              Pack="true"
              PackagePath="runtimes\linux-x64\native"
              CopyToOutputDirectory="PreserveNewest"
              Link="runtimes\linux-x64\native\libtree-sitter-fsharp.so" />
        <None Include="..\runtimes\linux-arm64\native\libtree-sitter-fsharp.so"
              Condition="Exists('..\runtimes\linux-arm64\native\libtree-sitter-fsharp.so')"
              Pack="true"
              PackagePath="runtimes\linux-arm64\native"
              CopyToOutputDirectory="PreserveNewest"
              Link="runtimes\linux-arm64\native\libtree-sitter-fsharp.so" />

        <!-- The FSI host is a build-time dependency: the daemon spawns
             SageFs.Host.exe from its own dir (Args.hostExePath). Reference
             with PrivateAssets so the host exe + its DLLs ride in the tool's
             normal tools/<tfm>/any/ payload (no subdir, no installer tricks). -->
        <ProjectReference Include="..\SageFs.Host\SageFs.Host.fsproj"
                          PrivateAssets="all"
                          ReferenceOutputAssembly="false" />

        <!-- PackAsTool drops the daemon's own exe when a referenced project
             also produces an exe (the pack mis-identifies SageFs.Host.exe as
             the tool). Explicitly include the daemon exe in the payload. -->
        <None Include="$(TargetDir)SageFs.exe"
              Pack="true"
              PackagePath="tools\$(TargetFramework)\any" />

        <!-- The FSI host runs from its OWN host/ subdir (the whole point of
             isolation — the host must not share a dir with the daemon's files,
             or its fail-closed manifest check rightly refuses). The host's
             output is packed under tools/<tfm>/any/host/ via the
             PackHostForDaemon target below (NOT a static None item: on a fresh
             CI checkout the host bin dir does not exist at evaluation time, so
             a static item with an Exists() condition would silently pack
             nothing and the installed tool would have no host/ dir). -->
    </ItemGroup>

    <!--
      Ship the FSI host alongside the daemon. The daemon spawns
      SageFs.Host.exe relative to its own base dir (Args.hostExePath), so the
      host's build output must land in the daemon's output dir (dev) AND in
      the tool package under tools/<tfm>/any/host/ (installed tool).
    -->
    <Target Name="BuildHostForDaemon" BeforeTargets="Build;Pack">
        <MSBuild Projects="..\SageFs.Host\SageFs.Host.fsproj"
                 Targets="Build"
                 Properties="Configuration=$(Configuration);TargetFramework=$(HostTargetFramework)" />
    </Target>

    <!-- Pack the host's full output into tools/<tfm>/any/host/. Runs after
         BuildHostForDaemon has produced it AND before the pack target
         collects package files (_GetPackageFiles is where Pack reads the
         None items), so the glob sees real files even on a fresh CI
         checkout. -->
    <Target Name="PackHostForDaemon" BeforeTargets="_GetPackageFiles" AfterTargets="BuildHostForDaemon">
        <ItemGroup>
            <HostPackFiles Include="..\SageFs.Host\bin\$(Configuration)\$(HostTargetFramework)\**\*"
                           Exclude="..\SageFs.Host\bin\$(Configuration)\$(HostTargetFramework)\**\*.runtimeconfig.dev.json"
                           Condition="Exists('..\SageFs.Host\bin\$(Configuration)\$(HostTargetFramework)\SageFs.Host.dll')" />
        </ItemGroup>
        <ItemGroup>
            <None Include="@(HostPackFiles)"
                  Pack="true"
                  PackagePath="tools\$(TargetFramework)\any\host\%(RecursiveDir)"
                  LinkBase="hostout" />
        </ItemGroup>
    </Target>

    <Target Name="CopyHostOutput" AfterTargets="Build">
        <ItemGroup>
            <!-- Exclude the Debug-only *.runtimeconfig.dev.json — it is not in
                 the vetted manifest and the host's fail-closed check would
                 refuse to start with it present. -->
            <HostFiles Include="..\SageFs.Host\bin\$(Configuration)\$(HostTargetFramework)\**\*"
                        Exclude="..\SageFs.Host\bin\$(Configuration)\$(HostTargetFramework)\**\*.runtimeconfig.dev.json"
                        Condition="Exists('..\SageFs.Host\bin\$(Configuration)\$(HostTargetFramework)')" />
        </ItemGroup>
        <!-- Copy the host's FULL output into the daemon's host/ subdir so the
             daemon spawns host/SageFs.Host.exe with its isolated closure. -->
        <Copy SourceFiles="@(HostFiles)"
              DestinationFiles="@(HostFiles->'$(TargetDir)host\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>

</Project>
