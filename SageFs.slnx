    <!-- The MCP run_app/stop_app outcome gate and the dashboard browser
         journeys create real sessions on ConsoleTicker, and a session warms up
         by loading the project's built assembly. Left out of the solution, it
         was never built by CI's `dotnet build`, so those gates failed on a
         fresh runner with "Not all DLLs are found (1 missing:
         SageFs.Samples.ConsoleTicker.dll)" while passing on any machine that
         had once built it by hand. -->
    <Project Path="samples/demos/SageFs.Samples.ConsoleTicker/SageFs.Samples.ConsoleTicker.fsproj" />
