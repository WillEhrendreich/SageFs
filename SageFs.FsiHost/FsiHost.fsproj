<Project Sdk="Microsoft.NET.Sdk">

  <!-- The isolated FSI host. NOT part of the SageFs solution: SageFs.Core embeds these three files and
       FsiHostBuild copies them into a cache directory and builds them with the PROJECT'S OWN SDK, so this
       program is compiled by that SDK's fsc against that SDK's FSharp.Compiler.Service and FSharp.Core.
       Nothing from SageFs is referenced, so nothing from SageFs can conflict with the user's packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net$(BundledNETCoreAppTargetFrameworkVersion)</TargetFramework>
    <AssemblyName>FsiHost</AssemblyName>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
    <RestoreEnableSdkReferences>false</RestoreEnableSdkReferences>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- MSBuildExtensionsPath has a trailing slash on SDK 10 but not on SDK 11: normalise it. -->
    <FSharpSdkDir>$([MSBuild]::EnsureTrailingSlash('$(MSBuildExtensionsPath)'))FSharp/</FSharpSdkDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The user's code runs in THIS process, so this process must have every shared framework the user's code may need. The
         worker it replaces was itself a web app, so web projects (Microsoft.AspNetCore.*) worked in it; without this line their
         references resolve to the reference pack, which cannot be loaded for execution. Bundled with every SDK, loaded lazily. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
      <!-- The agent (hot reload + live testing) that lives beside the user's code. Same source files SageFs.Core compiles. -->
    <Compile Include="Measures.fs" />
    <Compile Include="Utils.fs" />
    <!-- FSI's own naming rules, mirrored from the compiler source. The host's
         LiveTestingExecutors normalizes a re-eval'd test's reflected type name
         with these, so this file must stay in the host closure — leaving it out
         makes the host fail to COMPILE, which surfaces only as
         `HostUnavailable` and a silent fall back to default config. -->
    <Compile Include="FsiNaming.fs" />
    <Compile Include="Timeouts.fs" />
    <Compile Include="Instrumentation.fs" />
    <Compile Include="DirectoryConfigTypes.fs" />
    <Compile Include="ConfigDsl.fs" />
    <Compile Include="LiveValueTree.fs" />
    <Compile Include="LiveTestingTypes.fs" />
    <Compile Include="CoverageProbes.fs" />
    <Compile Include="LiveTestingInstrumentation.fs" />
    <Compile Include="ReflectionDiscovery.fs" />
    <Compile Include="LiveTestingExecutors.fs" />
    <Compile Include="DevReload.fs" />
    <!-- Rule 2: where a module value's reads went (pure), and the probes and startup
         watch that learn which readers ran. Both before HotReloadCore, which releases a
         watch before it detours a method. -->
    <Compile Include="ValueReads.fs" />
    <Compile Include="ValueReadTracking.fs" />
    <Compile Include="HotReloadCore.fs" />
    <Compile Include="HostAgent.fs" />
    <Compile Include="FsiProtocol.fs" />
    <Compile Include="FcsQueries.fs" />
    <Compile Include="Program.fs" />
    <Reference Include="FSharp.Core"><HintPath>$(FSharpSdkDir)FSharp.Core.dll</HintPath></Reference>
    <Reference Include="FSharp.Compiler.Service"><HintPath>$(FSharpSdkDir)FSharp.Compiler.Service.dll</HintPath></Reference>
    <Reference Include="FSharp.DependencyManager.Nuget"><HintPath>$(FSharpSdkDir)FSharp.DependencyManager.Nuget.dll</HintPath></Reference>
    <!-- SageFs's Harmony fork under its OWN assembly identity (FsiHostBuild renames it): a project that references
         Lib.Harmony (assembly 0Harmony) must never collide with the agent's copy. -->
    <Reference Include="SageFs.HostHarmony"><HintPath>SageFs.HostHarmony.dll</HintPath></Reference>
  </ItemGroup>

</Project>
