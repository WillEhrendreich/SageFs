# SageFs as a systemd USER unit.
#
#   mkdir -p ~/.config/systemd/user
#   cp contrib/systemd/sagefs.service ~/.config/systemd/user/
#   systemctl --user enable --now sagefs
#
# The daemon then outlives every agent, terminal and editor, and comes back at
# login. Add `loginctl enable-linger $USER` if it should also start at boot,
# before you log in.
#
# ExecStart assumes `dotnet tool install --global SageFs`, which puts the
# executable at ~/.dotnet/tools/sagefs (%h is your home directory). The tool's
# launcher finds the runtime through DOTNET_ROOT, and a user unit does not read
# your shell profile, so it is set here. Change both lines if dotnet lives
# somewhere else.
#
# The daemon's working directory is NOT your home directory. A request that names
# no working directory (a session create, get_available_projects) falls back to
# the daemon's own cwd, so a daemon started in $HOME hands $HOME out as a session
# root. SageFs refuses to watch a home directory (a recursive watch there would
# spend an inotify watch on every directory under it), so a session rooted there
# gets no hot reload and no live testing. StateDirectory=sagefs makes systemd
# create ~/.local/state/sagefs (%S/sagefs) before the daemon starts, and
# WorkingDirectory points at it. Open your sessions in a project directory.

[Unit]
Description=SageFs daemon (F# REPL, MCP server, dashboard)
After=network.target

[Service]
Type=simple
Environment=DOTNET_ROOT=%h/.dotnet
StateDirectory=sagefs
WorkingDirectory=%S/sagefs
ExecStart=%h/.dotnet/tools/sagefs --supervised
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
