<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <RootNamespace>SageFs.VisualStudio.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Explicit FSharp.Core ensures 10.x wins over FsUnit.xUnit's bundled 5.0.2 (netstandard2.0) -->
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="FsUnit.xUnit" />
    <PackageReference Include="FsCheck" />
    <PackageReference Include="FsCheck.Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SageFs.VisualStudio.Core\SageFs.VisualStudio.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="DaemonTargetFinderTests.fs" />
    <Compile Include="LiveTestStateTests.fs" />
    <Compile Include="GlyphProjectionTests.fs" />
    <Compile Include="LiveTestingParserTests.fs" />
    <Compile Include="TestTreeViewModelTests.fs" />
    <Compile Include="JsonParsersTests.fs" />
    <Compile Include="EvalServiceTests.fs" />
    <Compile Include="CompletionRequestTests.fs" />
    <Compile Include="BufferChangeRequestTests.fs" />
    <Compile Include="LiveTestingFormatTests.fs" />
    <Compile Include="TypeExplorerGuardTests.fs" />
    <Compile Include="DaemonManagerTests.fs" />
    <Compile Include="SageFsClientVersionTests.fs" />
  </ItemGroup>
</Project>
