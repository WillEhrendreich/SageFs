<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>SageFs.VisualStudio.Editor</RootNamespace>
    <AssemblyName>SageFs.VisualStudio.Editor</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- net472 does not support TreatWarningsAsErrors cleanly with nullable refs — suppress the inherited setting -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- VS Editor MEF packages — version-pinned; this project opts out of central package management.
         PrivateAssets="all" is CRITICAL: VS SDK types have identity issues if loaded twice.
         Without this, the VSIX's copy and the MEF assembly's copy conflict and cause mysterious crashes. -->
    <PackageReference Include="Microsoft.VisualStudio.Text.UI.Wpf" Version="17.13.226" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Text.UI" Version="17.13.226" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.CoreUtility" Version="17.13.226" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Text.Data" Version="17.13.226" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Language" Version="17.13.226" PrivateAssets="all" />
    <!-- Shell.15.0 provides ThreadHelper, ServiceProvider, IVsStatusbar, SVsStatusbar for StatusBarService. -->
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="17.13.40008" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SageFs.VisualStudio.Editor.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <!-- WPF framework assemblies (not available as NuGet on net472; must be referenced directly) -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <!-- HttpClient on net472 -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
