<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml">
  <Border Padding="8">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!-- Toolbar: Toggle + Run All + Filter + Refresh + Connection Status -->
        <DockPanel Margin="0,0,0,8">
          <TextBlock Text="{Binding ConnectionStatus}"
                     DockPanel.Dock="Right"
                     VerticalAlignment="Center"
                     FontFamily="Cascadia Code,Consolas,Courier New"
                     FontSize="10"
                     Foreground="Gray"
                     Margin="8,0,0,0" />
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button Content="{Binding EnabledStatus}"
                    Command="{Binding ToggleCommand}"
                    MinHeight="24" MinWidth="120"
                    Margin="0,0,4,0" />
            <Button Content="▶ Run All"
                    Command="{Binding RunAllCommand}"
                    MinHeight="24" MinWidth="80"
                    Margin="0,0,4,0" />
            <Button Content="{Binding FilterLabel}"
                    Command="{Binding CycleFilterCommand}"
                    MinHeight="24" MinWidth="60"
                    Margin="0,0,4,0"
                    ToolTip="Click to cycle: All → Failed → Running → Stale → Passed" />
            <Button Content="↻"
                    Command="{Binding RefreshCommand}"
                    MinHeight="24" MinWidth="30" />
          </StackPanel>
        </DockPanel>

        <!-- Search -->
        <DockPanel Margin="0,0,0,8">
          <Button Content="✕"
                  Command="{Binding ClearSearchCommand}"
                  MinHeight="24" MinWidth="24"
                  DockPanel.Dock="Right"
                  Margin="4,0,0,0" />
          <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                   MinHeight="24"
                   FontFamily="Cascadia Code,Consolas,Courier New"
                   FontSize="11" />
        </DockPanel>

        <!-- Summary -->
        <TextBlock Text="{Binding SummaryText}"
                   FontFamily="Cascadia Code,Consolas,Courier New"
                   FontSize="13" FontWeight="Bold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <!-- Test results (grouped by file) -->
        <TextBlock Text="{Binding TestResultsText}"
                   FontFamily="Cascadia Code,Consolas,Courier New"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <!-- Recent events -->
        <TextBlock Text="{Binding RecentEventsText}"
                   FontFamily="Cascadia Code,Consolas,Courier New"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <!-- Run Policy section (collapsible) -->
        <DockPanel Margin="0,8,0,0">
          <Button Content="⚙ Run Policies"
                  Command="{Binding ToggleRunPolicySectionCommand}"
                  DockPanel.Dock="Left"
                  MinHeight="22" MinWidth="110"
                  FontSize="11"
                  Margin="0,0,0,4" />
        </DockPanel>

        <StackPanel Visibility="{Binding RunPolicySectionVisible, Converter={x:Static vs:Converters.BoolToVisibilityConverter}}"
                    Margin="0,0,0,8">
          <!-- Current policies read-only summary -->
          <TextBlock Text="Current policies:"
                     FontFamily="Cascadia Code,Consolas,Courier New"
                     FontSize="10"
                     Foreground="Gray"
                     Margin="0,0,0,2" />
          <TextBlock Text="{Binding CurrentPoliciesText}"
                     FontFamily="Cascadia Code,Consolas,Courier New"
                     FontSize="10"
                     TextWrapping="Wrap"
                     Margin="0,0,0,8" />
          <TextBlock Text="Category:"
                     FontFamily="Cascadia Code,Consolas,Courier New"
                     FontSize="11"
                     Margin="0,0,0,2" />
          <ComboBox ItemsSource="{Binding CategoryLabels}"
                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                    MinHeight="24"
                    FontFamily="Cascadia Code,Consolas,Courier New"
                    FontSize="11"
                    Margin="0,0,0,6" />
          <TextBlock Text="Policy:"
                     FontFamily="Cascadia Code,Consolas,Courier New"
                     FontSize="11"
                     Margin="0,0,0,2" />
          <ComboBox ItemsSource="{Binding PolicyLabels}"
                    SelectedItem="{Binding SelectedPolicy, Mode=TwoWay}"
                    MinHeight="24"
                    FontFamily="Cascadia Code,Consolas,Courier New"
                    FontSize="11"
                    Margin="0,0,0,6" />
          <Button Content="Apply"
                  Command="{Binding ApplyRunPolicyCommand}"
                  MinHeight="24" MinWidth="70"
                  FontSize="11" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</DataTemplate>
