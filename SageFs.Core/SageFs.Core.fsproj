<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <IsPackable>false</IsPackable>
        <!-- Core targets net10.0 via Directory.Build.props. See the props file
             for why NOT net11: Harmony/MonoMod do not support CoreCLR 11, and
             Core is loaded into the FSI host which detours methods at runtime. -->
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SageFs.Tests" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="WorkflowTypes.fs" />
        <Compile Include="Args.fs" />
        <Compile Include="OwnerMonitor.fs" />
        <Compile Include="McpResourceGate.fs" />
        <Compile Include="Measures.fs" />
        <Compile Include="Cohort.fs" />
        <Compile Include="RingBuffer.fs" />
        <Compile Include="SseReplayBuffer.fs" />
        <Compile Include="ModelSnapshot.fs" />
        <Compile Include="TimeTravel.fs" />
        <Compile Include="Utils.fs" />
        <Compile Include="NativeResolution.fs" />
        <Compile Include="AppOutput.fs" />
        <Compile Include="Checkout.fs" />
        <Compile Include="MemberTable.fs" />
        <Compile Include="Tutorial.fs" />
        <Compile Include="SageFsConfig.fs" />
        <Compile Include="Timeouts.fs" />
        <Compile Include="Settings.fs" />
        <Compile Include="SettingsStore.fs" />
        <Compile Include="SettingsCatalog.fs" />
        <Compile Include="EvalLatencyTrace.fs" />
        <Compile Include="Features\Treemap.fs" />
        <Compile Include="BatchFlusher.fs" />
        <Compile Include="BinaryFormat.fs" />
        <Compile Include="Instrumentation.fs" />
        <Compile Include="McpToolAudit.fs" />
        <Compile Include="FeatureParity.fs" />
        <Compile Include="EndpointContracts.fs" />
        <Compile Include="ResilientActor.fs" />
        <Compile Include="RuntimeCompat.fs" />
        <!-- One source file, compiled into BOTH this assembly and the per-SDK generated FSI host: the wire
             protocol cannot drift because there is only one definition of it. -->
        <Compile Include="../SageFs.FsiHost/FsiProtocol.fs" Link="FsiProtocol.fs" />
        <Compile Include="FsiHostBuild.fs" />
        <Compile Include="FsiHostClient.fs" />
        <!-- The isolated FSI host's project + sources ship inside this assembly; FsiHostBuild writes them to a
             cache directory and builds them with the project's own SDK. -->
        <EmbeddedResource Include="../SageFs.FsiHost/FsiHost.fsproj" LogicalName="FsiHost/FsiHost.fsproj" />
        <EmbeddedResource Include="../SageFs.FsiHost/FsiProtocol.fs" LogicalName="FsiHost/FsiProtocol.fs" />
        <EmbeddedResource Include="../SageFs.FsiHost/Program.fs" LogicalName="FsiHost/Program.fs" />
        <Compile Include="ProjectLoading.fs" />
        <Compile Include="Features\ReloadPlanning.fs" />
        <Compile Include="ShadowCopy.fs" />
        <Compile Include="WarmUp.fs" />
        <Compile Include="AspireSetup.fs" />
        <Compile Include="ErrorMessages.fs" />
        <Compile Include="WorkflowErrorContext.fs" />
        <Compile Include="Features\LiveTestingTypes.fs" />
        <Compile Include="Features\TestRunKey.fs" />
        <Compile Include="Features\InputHashCoverage.fs" />
        <Compile Include="Features\AffectedTests.fs" />
        <Compile Include="Features\LandingCache.fs" />
        <Compile Include="Features\LiveTestActivity.fs" />
        <Compile Include="Features\TestCachePersistence.fs" />
        <Compile Include="Features\CoverageInstrumenter.fs" />
        <Compile Include="Features\LiveTestingInstrumentation.fs" />
        <Compile Include="Features\ReflectionDiscovery.fs" />
        <Compile Include="Features\LiveTestingExecutors.fs" />
        <Compile Include="Features\TestDiscoveryMerge.fs" />
        <Compile Include="Features\TestTreeSitter.fs" />
        <Compile Include="Features\AutoCompletion.fs" />
        <Compile Include="Features\Diagnostics.fs" />
        <Compile Include="Features\DiagnosticsStore.fs" />
        <Compile Include="Features\Events.fs" />
        <Compile Include="Features\DaemonManifest.fs" />
        <Compile Include="Features\ManifestPersistence.fs" />
        <Compile Include="Features\DaemonPersistence.fs" />
        <Compile Include="Features\ManifestOwner.fs" />
        <Compile Include="Features\CohortLedger.fs" />
        <Compile Include="Features\CohortOwner.fs" />
        <Compile Include="Features\CohortTestProjection.fs" />
        <Compile Include="Features\CohortMatrixRender.fs" />
        <Compile Include="Features\CohortTerritory.fs" />
        <Compile Include="Features\CohortBoundedView.fs" />
        <Compile Include="Features\CohortStatusText.fs" />
        <Compile Include="Features\CohortLanes.fs" />
        <Compile Include="Features\CohortScrubber.fs" />
        <Compile Include="Features\CohortIntegrationScope.fs" />
        <Compile Include="Features\EvalDedup.fs" />
        <Compile Include="Features\EvalDiff.fs" />
        <Compile Include="Features\IdentifierScan.fs" />
        <Compile Include="Features\CellDependencyGraph.fs" />
        <Compile Include="Features\TestSourceResolver.fs" />
        <Compile Include="Features\EvalProvenance.fs" />
        <Compile Include="Features\SessionScribe.fs" />
        <Compile Include="Features\MessageJournal.fs" />
        <Compile Include="Features\TestNarration.fs" />
        <Compile Include="Features\DaemonHealth.fs" />
        <Compile Include="Features\ScratchPad.fs" />
        <Compile Include="Features\EvalRipple.fs" />
        <Compile Include="Features\EvalLens.fs" />
        <Compile Include="Features\WhatIf.fs" />
        <Compile Include="Features\Ghostwriter.fs" />
        <Compile Include="Features\SessionFilmstrip.fs" />
        <Compile Include="Features\FsiOutputParser.fs" />
        <Compile Include="Features\BindingExplorer.fs" />
        <Compile Include="Features\LiveValueTree.fs" />
        <Compile Include="Features\LiveBindingsAdaptive.fs" />
        <Compile Include="Features\DomainModelViz.fs" />
        <Compile Include="Features\EvalTimeline.fs" />
        <Compile Include="Features\NotebookExport.fs" />
        <Compile Include="Features\CoverageIntel.fs" />
        <Compile Include="Features\ImpactForecast.fs" />
        <Compile Include="Features\ActionPrioritizer.fs" />
        <Compile Include="Features\TestDiscovery.fs" />
        <Compile Include="Features\CellDependenciesReport.fs" />
        <Compile Include="Features\FeatureDiscovery.fs" />
        <Compile Include="Features\Diagnostician.fs" />
        <Compile Include="RetryPolicy.fs" />
        <Compile Include="SseWriter.fs" />
    <Compile Include="Features\EvalStore.fs" />
    <Compile Include="Features\FeatureHooks.fs" />
    <Compile Include="Features\FrictionTelemetryTypes.fs" />
        <Compile Include="Features\FrictionTelemetry.fs" />
        <Compile Include="Features\FrictionSanitize.fs" />
        <Compile Include="Features\FrictionOtelProjection.fs" />
        <!-- FrictionSqlite.fs, FrictionReviewView.fs, McpFrictionRecorder.fs
             moved to SageFs.fsproj — friction storage is daemon-only; the
             worker process (SageFs.Host) never referenced them, so they
             pulled Microsoft.Data.Sqlite into its closure for nothing. -->
        <!-- Observed (passive) friction — pure derivation over FrictionEvent
             (observed-friction-plan.md). Types first, then one stub file per
             Wave-1 detector brief (B1-B6, each a no-op `[] `until its brief
             lands), then the engine that registers every stub. -->
        <Compile Include="Features\ObservedFrictionTypes.fs" />
        <Compile Include="Features\ObservedFriction.Polling.fs" />
        <Compile Include="Features\ObservedFriction.ResetThrash.fs" />
        <Compile Include="Features\ObservedFriction.Unattributed.fs" />
        <Compile Include="Features\ObservedFriction.Resolution.fs" />
        <Compile Include="Features\ObservedFriction.Repetition.fs" />
        <Compile Include="Features\ObservedFriction.InvalidState.fs" />
        <Compile Include="Features\ObservedFriction.fs" />
        <Compile Include="FsiRewrite.fs" />
        <Compile Include="SessionState.fs" />
        <Compile Include="SageFsError.fs" />
        <!-- After SageFsError: F#-aware compile-order insight over BuildDiagnostic (roast UX-4). -->
        <Compile Include="CompileOrderInsight.fs" />
        <!-- After SageFsError: the railway effect type over the algebra. -->
        <Compile Include="SageFsIO.fs" />
        <!-- After SageFsError: an app state carries the structured error that ended its run. -->
        <Compile Include="AppRun.fs" />
        <Compile Include="ResultEx.fs" />
        <Compile Include="EvalPipeline.fs" />
        <Compile Include="Affordances.fs" />
        <Compile Include="WorkerProtocol.fs" />
        <Compile Include="Features\CohortLedgerExport.fs" />
        <Compile Include="CrossCheckoutOverlap.fs" />
        <Compile Include="Features\Verification.fs" />
        <Compile Include="SessionMode.fs" />
        <Compile Include="AppRunOrchestration.fs" />
        <Compile Include="HttpWorkerClient.fs" />
        <Compile Include="HostManifest.fs" />
        <Compile Include="VariantSelector.fs" />
        <Compile Include="HostAdaptation.fs" />
        <Compile Include="HostCoreAdoption.fs" />
        <Compile Include="Supervisor.fs" />
        <Compile Include="RestartPolicy.fs" />
        <Compile Include="SmartReset.fs" />
        <Compile Include="Watchdog.fs" />
        <Compile Include="SessionLifecycle.fs" />
        <Compile Include="WorkerEventGuard.fs" />
        <Compile Include="WorkerHealthProbe.fs" />
        <Compile Include="SessionBuild.fs" />
        <Compile Include="SessionManager.fs" />
        <Compile Include="SessionOperations.fs" />
        <Compile Include="AgentActivityTracker.fs" />
        <Compile Include="DaemonState.fs" />
        <Compile Include="WarmupContext.fs" />
        <Compile Include="WarmupReplayCache.fs" />
        <Compile Include="StartupProfile.fs" />
        <Compile Include="HotReloadState.fs" />
        <Compile Include="HttpOriginGuard.fs" />
        <Compile Include="DevReload.fs" />
        <Compile Include="FileWatcher.fs" />
        <Compile Include="DaemonOwnership.fs" />
        <Compile Include="LiveTestWatcherCore.fs" />
        <!-- Pure eval-actor decision core (SessionActivity/SessionGeneration/
             EvalPhase/EvalInput/EvalDecision/decide) — compiled BEFORE
             AppState.fs so it stays a standalone file the DST harness can
             fold, instead of ratcheting AppState.fs over its line budget
             (see EvalActorDecision.fs's header for why it can't be nested). -->
        <Compile Include="EvalActorDecision.fs" />
        <Compile Include="FsiSession.fs" />
        <Compile Include="AppState.fs" />
        <Compile Include="Middleware\FsiCompatibility.fs" />
        <Compile Include="Middleware\ComputationExpression.fs" />
        <Compile Include="Middleware\Directives.fs" />
        <Compile Include="Middleware\CompilationContext.fs" />
        <Compile Include="Middleware\NonBlockingRun.fs" />
        <Compile Include="Middleware\HotReloading.fs" />
        <Compile Include="Middleware\Tracing.fs" />
        <Compile Include="ActorCreation.fs" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="base.fsx" />
        <EmbeddedResource Include="highlights.scm" LogicalName="highlights.scm" />
        <EmbeddedResource Include="tests.scm" LogicalName="tests.scm" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\runtimes\win-x64\native\tree-sitter-fsharp.dll"
              Pack="true"
              PackagePath="runtimes\win-x64\native"
              CopyToOutputDirectory="PreserveNewest"
              Link="runtimes\win-x64\native\tree-sitter-fsharp.dll" />
        <None Include="..\runtimes\osx-arm64\native\libtree-sitter-fsharp.dylib"
              Condition="Exists('..\runtimes\osx-arm64\native\libtree-sitter-fsharp.dylib')"
              Pack="true"
              PackagePath="runtimes\osx-arm64\native"
              CopyToOutputDirectory="PreserveNewest"
              Link="runtimes\osx-arm64\native\libtree-sitter-fsharp.dylib" />
        <None Include="..\runtimes\osx-x64\native\libtree-sitter-fsharp.dylib"
              Condition="Exists('..\runtimes\osx-x64\native\libtree-sitter-fsharp.dylib')"
              Pack="true"
              PackagePath="runtimes\osx-x64\native"
              CopyToOutputDirectory="PreserveNewest"
              Link="runtimes\osx-x64\native\libtree-sitter-fsharp.dylib" />
        <None Include="..\runtimes\linux-x64\native\libtree-sitter-fsharp.so"
              Condition="Exists('..\runtimes\linux-x64\native\libtree-sitter-fsharp.so')"
              Pack="true"
              PackagePath="runtimes\linux-x64\native"
              CopyToOutputDirectory="PreserveNewest"
              Link="runtimes\linux-x64\native\libtree-sitter-fsharp.so" />
        <None Include="..\runtimes\linux-arm64\native\libtree-sitter-fsharp.so"
              Condition="Exists('..\runtimes\linux-arm64\native\libtree-sitter-fsharp.so')"
              Pack="true"
              PackagePath="runtimes\linux-arm64\native"
              CopyToOutputDirectory="PreserveNewest"
              Link="runtimes\linux-arm64\native\libtree-sitter-fsharp.so" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Compiler.Service" />
        <PackageReference Include="FSharp.Data.Adaptive" />
        <PackageReference Include="TreeSitter.DotNet" />

        <PackageReference Include="FuzzySharp" />
        <PackageReference Include="SageFs.Harmony" />
        <PackageReference Include="Ionide.ProjInfo" />
        <PackageReference Include="Ionide.ProjInfo.FCS" />
        <PackageReference Include="System.Configuration.ConfigurationManager" />
        <PackageReference Include="Fantomas.Core" />
        <PackageReference Include="FSharp.SystemTextJson" />
        <PackageReference Include="FsToolkit.ErrorHandling" />
        <!-- Explicit logging abstractions pin: FSharp.Compiler.Service does not
             always surface it transitively; the central-version pin keeps the
             closure stable across TFMs. -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <!-- SQLite (friction storage) is daemon-only — see SageFs.fsproj, which
             carries Microsoft.Data.Sqlite/SQLitePCLRaw.lib.e_sqlite3 and the
             CVE-2025-6965 pin comment. SageFs.Host (the worker process) never
             touches friction storage, so it must not link SQLite's native
             library into its closure. -->
        <PackageReference Include="Mono.Cecil" GeneratePathProperty="true" />
    </ItemGroup>

    <Target Name="AddCecilRocksReference" BeforeTargets="ResolveAssemblyReferences">
        <ItemGroup>
            <Reference Include="$(PkgMono_Cecil)\lib\netstandard2.0\Mono.Cecil.Rocks.dll" />
        </ItemGroup>
    </Target>

</Project>
