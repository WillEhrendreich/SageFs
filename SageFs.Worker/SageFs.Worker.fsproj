<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <AssemblyName>SageFs.Worker</AssemblyName>
        <RootNamespace>SageFs.Worker</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
